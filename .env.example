# Copy to .env for local development (with `vercel dev` or `vercel env pull`).
# On Vercel itself, set these in Project Settings > Environment Variables —
# do not commit a real .env file.

# MongoDB Atlas connection string (Database Access user + password, cluster URL)
MONGODB_URI=mongodb+srv://mobile-garage:123N@mobile-garage.biypspp.mongodb.net/?appName=mobile-garage

# Displayed contact details / used for WhatsApp links
GARAGE_WHATSAPP_NUMBER=971551531345
GARAGE_PHONE_DISPLAY=+971 55 153 1345

# Staff dashboard login (choose your own values)
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=a-long-random-string-at-least-32-characters

# Added automatically by Vercel once you create a Blob store in the
# project's Storage tab — you shouldn't need to set this by hand except
# for local development with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=

# Only needed if you ever point this frontend at an API on a different
# domain. Leave unset for the normal same-project setup.
# VITE_API_BASE_URL=/api
